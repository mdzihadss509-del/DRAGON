[Unit]
Description=B2B Minecraft Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=b2bbot
WorkingDirectory=/opt/b2b-bot
EnvironmentFile=/etc/b2b-bot/bot.env
ExecStart=/usr/bin/node /opt/b2b-bot/index.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
